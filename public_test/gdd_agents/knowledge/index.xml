          &lt;td style=&#34;text-align: left&#34;&gt;Primary reference for matchmaking&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;&lt;strong&gt;DMZ (Warzone)&lt;/strong&gt;&lt;/td&gt;

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "liveops/feature-flags.schema.json",
  "title": "Feature Flags Payload",
  "type": "object",
  "required": ["flags"],
  "properties": {
    "flags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "valueType", "defaultValue"],
        "properties": {
          "key": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,127}$"},
          "valueType": {"type": "string", "enum": ["boolean", "number", "string", "json"]},
          "defaultValue": {},
          "enabledPercentage": {"type": "number", "minimum": 0, "maximum": 100},
          "conditions": {"type": "array", "maxItems": 50, "items": {"type": "object"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

      &lt;tr&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;&lt;strong&gt;Escape from Tarkov&lt;/strong&gt;&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;Karma (Scav/PMC), Hideout, VOIP, co-op extracts, inventory grid&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;Primary reference for core loop&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;&lt;strong&gt;Hunt: Showdown&lt;/strong&gt;&lt;/td&gt;

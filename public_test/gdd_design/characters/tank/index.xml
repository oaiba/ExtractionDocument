    <item>
      <title>BULWARK - Hans Richter</title>
      <link>https://oaiba.github.io/ExtractionDocument/gdd_design/characters/tank/bulwark.html</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      
      <guid>https://oaiba.github.io/ExtractionDocument/gdd_design/characters/tank/bulwark.html</guid>
      <description>
        
        
        &lt;h2&gt;Operator Profile&lt;span class=&#34;hx:absolute hx:-mt-20&#34; id=&#34;operator-profile&#34;&gt;&lt;/span&gt;
    &lt;a href=&#34;#operator-profile&#34; class=&#34;subheading-anchor&#34; aria-label=&#34;Permalink for this section&#34;&gt;&lt;/a&gt;&lt;/h2&gt;&lt;blockquote&gt;
  &lt;p&gt;&lt;em&gt;&amp;ldquo;Behind me. Nothing gets through.&amp;rdquo;&lt;/em&gt;&lt;/p&gt;
&lt;/blockquote&gt;
&lt;h3&gt;Basic Information&lt;span class=&#34;hx:absolute hx:-mt-20&#34; id=&#34;basic-information&#34;&gt;&lt;/span&gt;
    &lt;a href=&#34;#basic-information&#34; class=&#34;subheading-anchor&#34; aria-label=&#34;Permalink for this section&#34;&gt;&lt;/a&gt;&lt;/h3&gt;&lt;table&gt;
  &lt;thead&gt;
      &lt;tr&gt;
          &lt;th style=&#34;text-align: left&#34;&gt;Attribute&lt;/th&gt;
          &lt;th style=&#34;text-align: left&#34;&gt;Value&lt;/th&gt;
      &lt;/tr&gt;
  &lt;/thead&gt;
  &lt;tbody&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;&lt;strong&gt;Real Name&lt;/strong&gt;&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;Hans Friedrich Richter&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;&lt;strong&gt;Codename&lt;/strong&gt;&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;BULWARK&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;&lt;strong&gt;Class&lt;/strong&gt;&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;Tank&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;&lt;strong&gt;Nationality&lt;/strong&gt;&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;German&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;&lt;strong&gt;Age&lt;/strong&gt;&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;41&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;&lt;strong&gt;Height&lt;/strong&gt;&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;195 cm (6&#39;5&amp;quot;)&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;&lt;strong&gt;Weight&lt;/strong&gt;&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;110 kg (243 lbs)&lt;/td&gt;
      &lt;/tr&gt;
  &lt;/tbody&gt;
&lt;/table&gt;
&lt;h3&gt;Background&lt;span class=&#34;hx:absolute hx:-mt-20&#34; id=&#34;background&#34;&gt;&lt;/span&gt;
    &lt;a href=&#34;#background&#34; class=&#34;subheading-anchor&#34; aria-label=&#34;Permalink for this section&#34;&gt;&lt;/a&gt;&lt;/h3&gt;&lt;p&gt;Hans Richter was the immovable object of GSG 9, Germany&amp;rsquo;s elite counter-terrorism unit. His ability to hold positions under overwhelming fire became legendary after a 2019 embassy siege where he protected 30 hostages for 8 hours with only a riot shield and his determination.&lt;/p&gt;
&lt;p&gt;After a political scandal forced budget cuts that disbanded his unit, Hans couldn&amp;rsquo;t return to civilian life. The Exclusion Zone offers what he needs: a clear mission, enemies to stop, and people to protect.&lt;/p&gt;
&lt;h3&gt;Personality Traits&lt;span class=&#34;hx:absolute hx:-mt-20&#34; id=&#34;personality-traits&#34;&gt;&lt;/span&gt;
    &lt;a href=&#34;#personality-traits&#34; class=&#34;subheading-anchor&#34; aria-label=&#34;Permalink for this section&#34;&gt;&lt;/a&gt;&lt;/h3&gt;&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;Stoic&lt;/strong&gt; - Rarely shows emotion&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Protective&lt;/strong&gt; - Lives for defending others&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Stubborn&lt;/strong&gt; - Will not retreat&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Honorable&lt;/strong&gt; - Respects worthy opponents&lt;/li&gt;
&lt;/ul&gt;
&lt;hr&gt;
&lt;h2&gt;Combat Statistics&lt;span class=&#34;hx:absolute hx:-mt-20&#34; id=&#34;combat-statistics&#34;&gt;&lt;/span&gt;
    &lt;a href=&#34;#combat-statistics&#34; class=&#34;subheading-anchor&#34; aria-label=&#34;Permalink for this section&#34;&gt;&lt;/a&gt;&lt;/h2&gt;&lt;h3&gt;Base Stats&lt;span class=&#34;hx:absolute hx:-mt-20&#34; id=&#34;base-stats&#34;&gt;&lt;/span&gt;
    &lt;a href=&#34;#base-stats&#34; class=&#34;subheading-anchor&#34; aria-label=&#34;Permalink for this section&#34;&gt;&lt;/a&gt;&lt;/h3&gt;&lt;table&gt;
  &lt;thead&gt;
      &lt;tr&gt;
          &lt;th style=&#34;text-align: left&#34;&gt;Stat&lt;/th&gt;
          &lt;th style=&#34;text-align: left&#34;&gt;Value&lt;/th&gt;
          &lt;th style=&#34;text-align: left&#34;&gt;Class Modifier&lt;/th&gt;
          &lt;th style=&#34;text-align: left&#34;&gt;Final&lt;/th&gt;
      &lt;/tr&gt;
  &lt;/thead&gt;
  &lt;tbody&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;&lt;strong&gt;Health&lt;/strong&gt;&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;100 HP&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;-&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;100 HP&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;&lt;strong&gt;Armor&lt;/strong&gt;&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;75&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;+25% cap&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;75 (max 125)&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;&lt;strong&gt;Sprint Speed&lt;/strong&gt;&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;5.5 m/s&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;-15%&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;4.675 m/s&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;&lt;strong&gt;Crouch Speed&lt;/strong&gt;&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;2.0 m/s&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;-&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;2.0 m/s&lt;/td&gt;
      &lt;/tr&gt;
  &lt;/tbody&gt;
&lt;/table&gt;
&lt;hr&gt;
&lt;h2&gt;Abilities&lt;span class=&#34;hx:absolute hx:-mt-20&#34; id=&#34;abilities&#34;&gt;&lt;/span&gt;
    &lt;a href=&#34;#abilities&#34; class=&#34;subheading-anchor&#34; aria-label=&#34;Permalink for this section&#34;&gt;&lt;/a&gt;&lt;/h2&gt;&lt;h3&gt;Active Ability: Riot Shield Deploy&lt;span class=&#34;hx:absolute hx:-mt-20&#34; id=&#34;active-ability-riot-shield-deploy&#34;&gt;&lt;/span&gt;
    &lt;a href=&#34;#active-ability-riot-shield-deploy&#34; class=&#34;subheading-anchor&#34; aria-label=&#34;Permalink for this section&#34;&gt;&lt;/a&gt;&lt;/h3&gt;&lt;blockquote&gt;
  &lt;p&gt;&lt;em&gt;&amp;ldquo;Deploy an indestructible riot shield. Cannot fire while active.&amp;rdquo;&lt;/em&gt;&lt;/p&gt;
&lt;/blockquote&gt;
&lt;table&gt;
  &lt;thead&gt;
      &lt;tr&gt;
          &lt;th style=&#34;text-align: left&#34;&gt;Property&lt;/th&gt;
          &lt;th style=&#34;text-align: left&#34;&gt;Value&lt;/th&gt;
      &lt;/tr&gt;
  &lt;/thead&gt;
  &lt;tbody&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;&lt;strong&gt;Cooldown&lt;/strong&gt;&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;80 seconds&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;&lt;strong&gt;Duration&lt;/strong&gt;&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;15 seconds&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;&lt;strong&gt;Shield Coverage&lt;/strong&gt;&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;180° frontal arc&lt;/td&gt;
      &lt;/tr&gt;
  &lt;/tbody&gt;
&lt;/table&gt;
&lt;h4&gt;Effects&lt;span class=&#34;hx:absolute hx:-mt-20&#34; id=&#34;effects&#34;&gt;&lt;/span&gt;
    &lt;a href=&#34;#effects&#34; class=&#34;subheading-anchor&#34; aria-label=&#34;Permalink for this section&#34;&gt;&lt;/a&gt;&lt;/h4&gt;&lt;table&gt;
  &lt;thead&gt;
      &lt;tr&gt;
          &lt;th style=&#34;text-align: left&#34;&gt;Effect&lt;/th&gt;
          &lt;th style=&#34;text-align: left&#34;&gt;Value&lt;/th&gt;
          &lt;th style=&#34;text-align: left&#34;&gt;Notes&lt;/th&gt;
      &lt;/tr&gt;
  &lt;/thead&gt;
  &lt;tbody&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;Damage Block&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;100% frontal&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;Cannot be broken&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;Movement Penalty&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;-40%&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;Very slow&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;Weapon Use&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;Secondary only&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;While shield up&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;Melee&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;Yes&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;Shield bash stuns&lt;/td&gt;
      &lt;/tr&gt;
  &lt;/tbody&gt;
&lt;/table&gt;
&lt;h4&gt;Shield Bash&lt;span class=&#34;hx:absolute hx:-mt-20&#34; id=&#34;shield-bash&#34;&gt;&lt;/span&gt;
    &lt;a href=&#34;#shield-bash&#34; class=&#34;subheading-anchor&#34; aria-label=&#34;Permalink for this section&#34;&gt;&lt;/a&gt;&lt;/h4&gt;&lt;table&gt;
  &lt;thead&gt;
      &lt;tr&gt;
          &lt;th style=&#34;text-align: left&#34;&gt;Property&lt;/th&gt;
          &lt;th style=&#34;text-align: left&#34;&gt;Value&lt;/th&gt;
      &lt;/tr&gt;
  &lt;/thead&gt;
  &lt;tbody&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;Damage&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;30&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;Stun Duration&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;1.5 seconds&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;Range&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;2 meters&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;Cooldown&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;5 seconds (during shield)&lt;/td&gt;
      &lt;/tr&gt;
  &lt;/tbody&gt;
&lt;/table&gt;
&lt;h4&gt;Upgrade Slots&lt;span class=&#34;hx:absolute hx:-mt-20&#34; id=&#34;upgrade-slots&#34;&gt;&lt;/span&gt;
    &lt;a href=&#34;#upgrade-slots&#34; class=&#34;subheading-anchor&#34; aria-label=&#34;Permalink for this section&#34;&gt;&lt;/a&gt;&lt;/h4&gt;&lt;p&gt;&lt;strong&gt;Slot 1 (Level 5):&lt;/strong&gt;&lt;/p&gt;
&lt;table&gt;
  &lt;thead&gt;
      &lt;tr&gt;
          &lt;th style=&#34;text-align: left&#34;&gt;Option&lt;/th&gt;
          &lt;th style=&#34;text-align: left&#34;&gt;Effect&lt;/th&gt;
      &lt;/tr&gt;
  &lt;/thead&gt;
  &lt;tbody&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;&lt;strong&gt;Extended Guard&lt;/strong&gt;&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;Duration +5 seconds (20s total)&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;&lt;strong&gt;Quick Deploy&lt;/strong&gt;&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;Cooldown -20 seconds (60s total)&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;&lt;strong&gt;Mobile Wall&lt;/strong&gt;&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;Movement penalty -15% (only -25%)&lt;/td&gt;
      &lt;/tr&gt;
  &lt;/tbody&gt;
&lt;/table&gt;
&lt;p&gt;&lt;strong&gt;Slot 2 (Level 20):&lt;/strong&gt;&lt;/p&gt;
&lt;table&gt;
  &lt;thead&gt;
      &lt;tr&gt;
          &lt;th style=&#34;text-align: left&#34;&gt;Option&lt;/th&gt;
          &lt;th style=&#34;text-align: left&#34;&gt;Effect&lt;/th&gt;
      &lt;/tr&gt;
  &lt;/thead&gt;
  &lt;tbody&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;&lt;strong&gt;Shield Bash+&lt;/strong&gt;&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;Bash damage +20, stun +0.5 sec&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;&lt;strong&gt;Reflective Surface&lt;/strong&gt;&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;10% damage reflected back to shooter&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;&lt;strong&gt;Steadfast&lt;/strong&gt;&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;Immune to stagger/knockback&lt;/td&gt;
      &lt;/tr&gt;
  &lt;/tbody&gt;
&lt;/table&gt;
&lt;p&gt;&lt;strong&gt;Slot 3 (Level 35):&lt;/strong&gt;&lt;/p&gt;
&lt;table&gt;
  &lt;thead&gt;
      &lt;tr&gt;
          &lt;th style=&#34;text-align: left&#34;&gt;Option&lt;/th&gt;
          &lt;th style=&#34;text-align: left&#34;&gt;Effect&lt;/th&gt;
      &lt;/tr&gt;
  &lt;/thead&gt;
  &lt;tbody&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;&lt;strong&gt;Forward Unto Dawn&lt;/strong&gt;&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;Gain 50 temp HP when deploying&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;&lt;strong&gt;Team Aura&lt;/strong&gt;&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;Allies behind shield gain +10% damage&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;&lt;strong&gt;Explosive Resistance&lt;/strong&gt;&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;Block 50% grenade damage&lt;/td&gt;
      &lt;/tr&gt;
  &lt;/tbody&gt;
&lt;/table&gt;
&lt;hr&gt;
&lt;h3&gt;Passive Ability: Living Wall&lt;span class=&#34;hx:absolute hx:-mt-20&#34; id=&#34;passive-ability-living-wall&#34;&gt;&lt;/span&gt;
    &lt;a href=&#34;#passive-ability-living-wall&#34; class=&#34;subheading-anchor&#34; aria-label=&#34;Permalink for this section&#34;&gt;&lt;/a&gt;&lt;/h3&gt;&lt;blockquote&gt;
  &lt;p&gt;&lt;em&gt;&amp;ldquo;The bigger they are, the harder they stand.&amp;rdquo;&lt;/em&gt;&lt;/p&gt;
&lt;/blockquote&gt;
&lt;table&gt;
  &lt;thead&gt;
      &lt;tr&gt;
          &lt;th style=&#34;text-align: left&#34;&gt;Condition&lt;/th&gt;
          &lt;th style=&#34;text-align: left&#34;&gt;Effect&lt;/th&gt;
      &lt;/tr&gt;
  &lt;/thead&gt;
  &lt;tbody&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;Standing still&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;+15% damage resistance&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;In cover&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;+20% damage resistance&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;Taking fire&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;Generate Aggro (enemies more likely to target you)&lt;/td&gt;
      &lt;/tr&gt;
  &lt;/tbody&gt;
&lt;/table&gt;
&lt;hr&gt;
&lt;h2&gt;Loadout&lt;span class=&#34;hx:absolute hx:-mt-20&#34; id=&#34;loadout&#34;&gt;&lt;/span&gt;
    &lt;a href=&#34;#loadout&#34; class=&#34;subheading-anchor&#34; aria-label=&#34;Permalink for this section&#34;&gt;&lt;/a&gt;&lt;/h2&gt;&lt;h3&gt;Default Loadout&lt;span class=&#34;hx:absolute hx:-mt-20&#34; id=&#34;default-loadout&#34;&gt;&lt;/span&gt;
    &lt;a href=&#34;#default-loadout&#34; class=&#34;subheading-anchor&#34; aria-label=&#34;Permalink for this section&#34;&gt;&lt;/a&gt;&lt;/h3&gt;&lt;table&gt;
  &lt;thead&gt;
      &lt;tr&gt;
          &lt;th style=&#34;text-align: left&#34;&gt;Slot&lt;/th&gt;
          &lt;th style=&#34;text-align: left&#34;&gt;Item&lt;/th&gt;
          &lt;th style=&#34;text-align: left&#34;&gt;Notes&lt;/th&gt;
      &lt;/tr&gt;
  &lt;/thead&gt;
  &lt;tbody&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;&lt;strong&gt;Primary&lt;/strong&gt;&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;SPAS-12 Shotgun&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;CQB power&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;&lt;strong&gt;Secondary&lt;/strong&gt;&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;.44 Magnum&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;High damage&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;&lt;strong&gt;Tactical&lt;/strong&gt;&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;Flashbang ×1, Extra Armor Plate&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;Entry + durability&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;&lt;strong&gt;Armor&lt;/strong&gt;&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;Heavy Vest&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;75 armor&lt;/td&gt;
      &lt;/tr&gt;
  &lt;/tbody&gt;
&lt;/table&gt;

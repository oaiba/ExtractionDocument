      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;&lt;strong&gt;The Finals&lt;/strong&gt;&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;Cross-platform parties, emote wheel, destruction&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;Reference for UX polish&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;&lt;strong&gt;ARC Raiders&lt;/strong&gt;&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;Social hub, team synergy&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;Reference for co-op design&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;&lt;strong&gt;Arena Breakout&lt;/strong&gt;&lt;/td&gt;
          &lt;td style=&#34;text-align: left&#34;&gt;After action report, mobile extraction shooter&lt;/td&gt;
